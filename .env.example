# ─── Database ───────────────────────────────────────────────
# Dev: SQLite. Prod: switch provider to postgresql in prisma/schema.prisma.
DATABASE_URL="postgresql://postgres:FindMeNowBaby@db.vvqjmaubdjndmjvcfxve.supabase.co:6543/postgres"

# ─── App ────────────────────────────────────────────────────
APP_URL="http://localhost:3000"
SESSION_SECRET="change-me-to-a-long-random-string"

# ─── Providers (all default to mocks in dev) ────────────────
PAYMENT_PROVIDER="mock"        # mock | payme
GENERATION_PROVIDER="mock"     # mock | replicate | openai
EMAIL_PROVIDER="console"       # console | resend
STORAGE_PROVIDER="local"       # local | db (blobs in the database, for serverless hosting) | supabase (not built)
# A provider named here but not implemented fails at startup rather than silently serving a mock.
ANALYTICS_PROVIDER="console"   # console | posthog | none

# ─── Admin ──────────────────────────────────────────────────
ADMIN_EMAILS="guynagar21@gmail.com"

# Dev convenience: publish automatically after automated QA (production: false → a human approves in /admin)
QA_AUTO_APPROVE="false"

# ─── Feature flags ──────────────────────────────────────────
# Packages are hidden automatically when not enough scenes are active.
FEATURE_GIFT_WRAP="true"
FEATURE_BONUS_CHARACTER="false"

# ─── Image generation (slot patches) ──────────────────────
# Needed by GENERATION_PROVIDER=openai and by the scripts. Keep it out of git.
OPENAI_API_KEY=""
GENERATION_MODEL="gpt-image-2"     # falls back to gpt-image-1 if the account cannot use it
GENERATION_QUALITY="medium"        # low | medium | high — medium is what the worlds were made at
GENERATION_RPM="5"                 # images per minute this account may request (tier 1 is 5)
GENERATION_BOTH_VARIANTS="false"   # true also generates hiding spot B (double the cost, replay-ready)

# ─── Hosting (Vercel) ────────────────────────────────────────
# DATABASE_URL="postgresql://..."   # a postgres:// URL switches Prisma to Postgres automatically (scripts/prisma-generate.mjs)
JOBS_MODE="in-process"             # inline on serverless hosts (generation runs inside the webhook request)
# DEFAULT_COUNTRY="IL"             # geo fallback when no x-vercel-ip-country header (dev/test)
