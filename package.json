{
  "name": "find-me",
  "version": "0.1.0",
  "private": true,
  "description": "איפה אני? — משחק חפש־ומצא אישי לילדים",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "db:push:postgres": "node scripts/prisma-generate.mjs && prisma db push --schema prisma/generated/schema.postgres.prisma --skip-generate",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset",
    "postinstall": "node scripts/prisma-generate.mjs",
    "setup": "prisma generate && prisma db push",
    "scenes:validate": "tsx scripts/validate-scenes.ts",
    "smoke": "tsx scripts/e2e-smoke.ts",
    "db:check": "tsx scripts/check-db-url.ts",
    "game:status": "tsx scripts/game-status.ts",
    "patches:judge": "tsx scripts/judge-patches.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "next": "^15.5.25",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sharp": "^0.35.4",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "prisma": "^6.19.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "deepmerge-ts": "^8.0.2"
  }
}
